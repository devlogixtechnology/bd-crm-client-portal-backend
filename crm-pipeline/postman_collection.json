{
  "info": {
    "name": "CRM Pipeline API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"baseUrl","value":"http://localhost/crm-pipeline"}],
  "item": [
    {
      "name":"POST /leads",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Demo Client\",\n  \"email\": \"demo@example.com\",\n  \"company\": \"Demo Company\",\n  \"source\": \"Website\",\n  \"stage\": \"new\",\n  \"value\": 50000\n}"},"url":{"raw":"{{baseUrl}}/leads","host":["{{baseUrl}}"],"path":["leads"]}}
    },
    {
      "name":"GET /leads",
      "request":{"method":"GET","url":{"raw":"{{baseUrl}}/leads","host":["{{baseUrl}}"],"path":["leads"]}}
    },
    {
      "name":"PUT /leads/1/stage",
      "request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"stage\": \"qualified\"\n}"},"url":{"raw":"{{baseUrl}}/leads/1/stage","host":["{{baseUrl}}"],"path":["leads","1","stage"]}}
    }
  ]
}
